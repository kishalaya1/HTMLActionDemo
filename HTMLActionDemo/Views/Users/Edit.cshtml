@model HTMLActionDemo.Models.User
@{ ViewData["Title"] = "Edit User"; }
<h1>Edit User <small class="text-muted fs-6">(HTTP GET loads form, HTTP PUT saves it via fetch)</small></h1>
<form id="editForm" method="post">
    @Html.AntiForgeryToken()
    <partial name="_UserFields" model="Model" />
    <button type="submit" class="btn btn-primary">Save (PUT)</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
    <div id="msg" class="mt-3"></div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('editForm').addEventListener('submit', async e => {
            e.preventDefault();
            const f = e.target;
            const body = {
                id: @Model.Id,
                firstName: f.FirstName.value, lastName: f.LastName.value, email: f.Email.value,
                phone: f.Phone.value || null, dateOfBirth: f.DateOfBirth.value,
                city: f.City.value || null, isActive: f.IsActive.checked
            };
            const res = await fetch('/Users/Edit/@Model.Id', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': f.querySelector('[name=__RequestVerificationToken]').value },
                body: JSON.stringify(body)
            });
            if (res.ok) location.href = '/Users';
            else document.getElementById('msg').innerHTML = '<div class="alert alert-danger">Save failed (' + res.status + ')</div>';
        });
    </script>
}
